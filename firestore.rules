rules_version = '2';

// Student Progress Tracker V4 — Firestore access policy.
// Guardians can only read the explicit safe projections, never teacher-private data.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function studentPath(studentId) {
      return /databases/$(database)/documents/students/$(studentId);
    }

    function batchPath(batchId) {
      return /databases/$(database)/documents/batches/$(batchId);
    }

    function blocked() {
      return exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)) ||
        (exists(userPath(request.auth.uid)) && get(userPath(request.auth.uid)).data.status == 'blocked');
    }

    function activeAccount() {
      return signedIn() && !blocked();
    }

    function isSuperAdmin() {
      return activeAccount() && request.auth.token.email == 'robiul20202090@gmail.com';
    }

    function isAdmin() {
      return isSuperAdmin() || (activeAccount() &&
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.isAdmin == true);
    }

    function ownsStudent(studentId) {
      return activeAccount() && exists(studentPath(studentId)) &&
        get(studentPath(studentId)).data.teacherUid == request.auth.uid;
    }

    // Also works in atomic creation batches, where the student/batch document is
    // created alongside dependent documents such as a plan or safe projection.
    function ownsStudentAfter(studentId) {
      return activeAccount() && getAfter(studentPath(studentId)).data.teacherUid == request.auth.uid;
    }

    function ownsBatch(batchId) {
      return activeAccount() && exists(batchPath(batchId)) &&
        get(batchPath(batchId)).data.teacherUid == request.auth.uid;
    }

    function ownsBatchAfter(batchId) {
      return activeAccount() && getAfter(batchPath(batchId)).data.teacherUid == request.auth.uid;
    }

    function approvedGuardian(studentId) {
      return activeAccount() && exists(
        /databases/$(database)/documents/guardianApprovals/$(request.auth.uid)/students/$(studentId)
      );
    }

    function hasBatchGuestAccess(batchId) {
      return activeAccount() && exists(
        /databases/$(database)/documents/batchGuestAccess/$(request.auth.uid)/batches/$(batchId)
      );
    }

    function canReadPublishedVersion(versionId) {
      return isAdmin() || (activeAccount() &&
        get(/databases/$(database)/documents/curriculumVersions/$(versionId)).data.status == 'published');
    }

    // An account owner maintains their own profile. Super-admins can manage accounts,
    // but this permission deliberately does not extend to any student-report collection.
    match /users/{uid} {
      allow create: if activeAccount() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'active';
      allow get: if activeAccount() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isSuperAdmin() || (activeAccount() && request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoURL', 'lastActiveAt', 'preferredLanguage', 'schemaVersion', 'updatedAt'
        ]));
      allow delete: if false;
    }

    // These documents contain teacher-private child data. Guardians and platform
    // administrators never receive direct read access.
    match /students/{studentId} {
      allow create: if activeAccount() && request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80;
      allow get, list: if activeAccount() && resource.data.teacherUid == request.auth.uid;
      allow update: if activeAccount() && resource.data.teacherUid == request.auth.uid &&
        request.resource.data.teacherUid == resource.data.teacherUid;
      allow delete: if activeAccount() && resource.data.teacherUid == request.auth.uid;
    }

    match /studentPlans/{studentId} {
      allow get, list: if ownsStudent(studentId);
      allow create, update: if ownsStudentAfter(studentId) &&
        request.resource.data.teacherUid == request.auth.uid && request.resource.data.studentId == studentId;
      allow delete: if ownsStudent(studentId);

      match /dailyLogs/{logId} {
        allow get, list: if ownsStudent(studentId);
        allow create, update: if ownsStudentAfter(studentId) &&
          request.resource.data.teacherUid == request.auth.uid && request.resource.data.studentId == studentId;
        allow delete: if ownsStudent(studentId);
      }

      match /assessments/{assessmentId} {
        allow get, list: if ownsStudent(studentId);
        allow create, update: if ownsStudentAfter(studentId) &&
          request.resource.data.teacherUid == request.auth.uid && request.resource.data.studentId == studentId;
        allow delete: if ownsStudent(studentId);
      }
    }

    // Safe guardian projections. These are separate from every teacher-private record.
    // The teacher may write a projection for their child; only an approved guardian may read it.
    match /guardianReports/{studentId} {
      allow get, list: if approvedGuardian(studentId);
      allow create, update: if ownsStudentAfter(studentId) &&
        request.resource.data.teacherUid == request.auth.uid && request.resource.data.studentId == studentId;
      allow delete: if ownsStudent(studentId);

      match /dailyLogs/{logId} {
        allow get, list: if approvedGuardian(studentId);
        allow create, update: if ownsStudentAfter(studentId) &&
          request.resource.data.teacherUid == request.auth.uid && request.resource.data.studentId == studentId;
        allow delete: if ownsStudent(studentId);
      }

      match /assessments/{assessmentId} {
        allow get, list: if approvedGuardian(studentId);
        allow create, update: if ownsStudentAfter(studentId) &&
          request.resource.data.teacherUid == request.auth.uid && request.resource.data.studentId == studentId;
        allow delete: if ownsStudent(studentId);
      }

      match /activity/{itemId} {
        allow get, list: if approvedGuardian(studentId);
        allow create, update: if ownsStudentAfter(studentId) &&
          request.resource.data.teacherUid == request.auth.uid && request.resource.data.studentId == studentId;
        allow delete: if ownsStudent(studentId);
      }
    }

    // Batches, raw sessions, and per-student session entries remain teacher-private.
    match /batches/{batchId} {
      allow create: if activeAccount() && request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80;
      allow get, list: if ownsBatch(batchId);
      allow update: if ownsBatch(batchId) && request.resource.data.teacherUid == resource.data.teacherUid;
      allow delete: if ownsBatch(batchId);

      match /sessions/{sessionId} {
        allow get, list: if ownsBatch(batchId);
        allow create, update: if ownsBatchAfter(batchId) &&
          request.resource.data.teacherUid == request.auth.uid && request.resource.data.batchId == batchId;
        allow delete: if ownsBatch(batchId);

        match /entries/{studentId} {
          allow get, list: if ownsBatch(batchId);
          allow create, update: if ownsBatchAfter(batchId) &&
            request.resource.data.teacherUid == request.auth.uid && request.resource.data.batchId == batchId &&
            request.resource.data.studentId == studentId;
          allow delete: if ownsBatch(batchId);
        }
      }
    }

    // Shared batch projection has no roster or child-private fields.
    match /batchSharedReports/{batchId} {
      allow get, list: if hasBatchGuestAccess(batchId);
      allow create, update: if ownsBatchAfter(batchId) &&
        request.resource.data.teacherUid == request.auth.uid && request.resource.data.batchId == batchId;
      allow delete: if ownsBatch(batchId);

      match /sessions/{sessionId} {
        allow get, list: if hasBatchGuestAccess(batchId);
        allow create, update: if ownsBatchAfter(batchId) &&
          request.resource.data.teacherUid == request.auth.uid && request.resource.data.batchId == batchId;
        allow delete: if ownsBatch(batchId);
      }
    }

    // Room codes are only a signed-in, exact-code lookup. They never contain reports.
    match /roomCodes/{code} {
      allow get: if activeAccount();
      allow list: if false;
      allow create: if activeAccount() && request.resource.data.teacherUid == request.auth.uid &&
        code.matches('[A-Z]{5}-[0-9]{2}-[A-Z]{5}') &&
        ((request.resource.data.type == 'student' &&
          request.resource.data.studentId is string && ownsStudentAfter(request.resource.data.studentId)) ||
         (request.resource.data.type == 'batch' &&
          request.resource.data.batchId is string && ownsBatchAfter(request.resource.data.batchId)));
      allow update: if false;
      allow delete: if activeAccount() && resource.data.teacherUid == request.auth.uid &&
        ((resource.data.type == 'student' && ownsStudent(resource.data.studentId)) ||
         (resource.data.type == 'batch' && ownsBatch(resource.data.batchId)));
    }

    // A guardian can create a request only for a valid room or for a batch to which
    // the guardian already has shared access. Teachers can list requests in their own workspace.
    match /guardianRequests/{teacherUid}/requests/{requestId} {
      allow create: if activeAccount() && request.resource.data.guardianUid == request.auth.uid &&
        request.resource.data.teacherUid == teacherUid && request.resource.data.status == 'pending' &&
        ((request.resource.data.roomType == 'student' &&
          exists(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)) &&
          get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.type == 'student' &&
          get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.studentId == request.resource.data.studentId &&
          get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.teacherUid == teacherUid) ||
         (request.resource.data.roomType == 'batch' && request.resource.data.batchId is string &&
          ((exists(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)) &&
            get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.type == 'batch' &&
            get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.batchId == request.resource.data.batchId &&
            get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.teacherUid == teacherUid) ||
           (exists(/databases/$(database)/documents/batchGuestAccess/$(request.auth.uid)/batches/$(request.resource.data.batchId)) &&
            get(/databases/$(database)/documents/batchGuestAccess/$(request.auth.uid)/batches/$(request.resource.data.batchId)).data.teacherUid == teacherUid))));
      allow get: if activeAccount() && (teacherUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
      allow list: if activeAccount() && teacherUid == request.auth.uid;
      allow update: if activeAccount() && teacherUid == request.auth.uid &&
        request.resource.data.guardianUid == resource.data.guardianUid &&
        request.resource.data.teacherUid == resource.data.teacherUid;
      allow delete: if activeAccount() && (teacherUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
    }

    // Approval is the capability for guardian access to one child’s safe projection.
    match /guardianApprovals/{guardianUid}/students/{studentId} {
      allow get, list: if activeAccount() && (guardianUid == request.auth.uid || ownsStudent(studentId));
      allow create: if ownsStudentAfter(studentId) && request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.guardianUid == guardianUid && request.resource.data.studentId == studentId;
      allow update: if false;
      allow delete: if ownsStudent(studentId);
    }

    // The reverse index is teacher-private and is used to list/revoke linked guardians.
    match /studentGuardians/{studentId}/guardians/{guardianUid} {
      allow get, list: if ownsStudent(studentId);
      allow create, update: if ownsStudentAfter(studentId) && request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.guardianUid == guardianUid && request.resource.data.studentId == studentId;
      allow delete: if ownsStudent(studentId);
    }

    // A grant permits only shared batch projections. A guardian may self-create one
    // only after entering an immediate-access batch code; a teacher can grant/revoke it.
    match /batchGuestAccess/{guardianUid}/batches/{batchId} {
      allow get, list: if activeAccount() && (guardianUid == request.auth.uid || ownsBatch(batchId));
      allow create: if (activeAccount() && guardianUid == request.auth.uid &&
          request.resource.data.guardianUid == guardianUid && request.resource.data.batchId == batchId &&
          exists(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)) &&
          get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.type == 'batch' &&
          get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.batchId == batchId &&
          get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.accessMode == 'immediate-batch' &&
          get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.teacherUid == request.resource.data.teacherUid) ||
        (ownsBatchAfter(batchId) && request.resource.data.teacherUid == request.auth.uid &&
          request.resource.data.guardianUid == guardianUid && request.resource.data.batchId == batchId);
      allow update: if ownsBatch(batchId) && request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.guardianUid == guardianUid && request.resource.data.batchId == batchId;
      allow delete: if ownsBatch(batchId);
    }

    // Notifications contain only a safe update pointer. The guardian can read
    // and mark their own notices; teachers can create a notice only for an
    // already approved guardian of a student they own. Administrators have no
    // access to this collection.
    match /guardianNotifications/{guardianUid}/items/{notificationId} {
      allow get, list: if activeAccount() && guardianUid == request.auth.uid;
      allow create: if activeAccount() && ownsStudent(request.resource.data.studentId) &&
        request.resource.data.guardianUid == guardianUid &&
        exists(/databases/$(database)/documents/guardianApprovals/$(guardianUid)/students/$(request.resource.data.studentId));
      allow update: if activeAccount() && guardianUid == request.auth.uid &&
        request.resource.data.guardianUid == resource.data.guardianUid &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'updatedAt']);
      allow delete: if activeAccount() && guardianUid == request.auth.uid;
    }

    // Active viewer presence is only visible to the owning teacher. A guardian may
    // refresh only their own presence document after child approval.
    match /presence/{studentId}/viewers/{guardianUid} {
      allow get, list: if ownsStudent(studentId);
      allow create, update: if approvedGuardian(studentId) && guardianUid == request.auth.uid &&
        request.resource.data.guardianUid == guardianUid && request.resource.data.studentId == studentId &&
        request.resource.data.lastSeen == request.time;
      allow delete: if activeAccount() && (guardianUid == request.auth.uid || ownsStudent(studentId));
    }

    // Teacher-private per-student operational notes and the teacher’s own activity feed.
    match /studentActivity/{studentId}/items/{itemId} {
      allow get, list: if ownsStudent(studentId);
      allow create, update: if ownsStudentAfter(studentId) &&
        request.resource.data.teacherUid == request.auth.uid && request.resource.data.studentId == studentId;
      allow delete: if ownsStudent(studentId);
    }

    match /teacherActivity/{teacherUid}/items/{itemId} {
      allow get, list: if activeAccount() && teacherUid == request.auth.uid;
      allow create: if activeAccount() && teacherUid == request.auth.uid &&
        request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Due-work planning is teacher-private and contains no guardian report data.
    match /teacherTasks/{teacherUid}/items/{taskId} {
      allow get, list: if activeAccount() && teacherUid == request.auth.uid;
      allow create: if activeAccount() && teacherUid == request.auth.uid &&
        request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 160 &&
        request.resource.data.kind in ['student', 'batch'] &&
        request.resource.data.status in ['due', 'done'];
      allow update: if activeAccount() && teacherUid == request.auth.uid &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'dueDate', 'status', 'updatedAt']);
      allow delete: if activeAccount() && teacherUid == request.auth.uid;
    }

    // The curriculum library is publicly readable to signed-in users only when the
    // version is published; changes are restricted to an administrator.
    match /curriculumVersions/{versionId} {
      allow get, list: if isAdmin() || (activeAccount() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();

      match /books/{bookId} {
        allow get, list: if canReadPublishedVersion(versionId);
        allow create, update, delete: if isAdmin();

        match /chapters/{chapterId} {
          allow get, list: if canReadPublishedVersion(versionId);
          allow create, update, delete: if isAdmin();
        }
      }
    }

    // Teachers can use their own templates; published global templates are readable
    // by signed-in users; only administrators may publish global templates.
    match /assessmentTemplates/{templateId} {
      allow get, list: if isAdmin() || (activeAccount() &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.scope == 'global' && resource.data.status == 'published')));
      allow create: if activeAccount() && request.resource.data.ownerUid == request.auth.uid &&
        (request.resource.data.scope == 'teacher' || isAdmin());
      allow update, delete: if isAdmin() || (activeAccount() && resource.data.ownerUid == request.auth.uid &&
        resource.data.scope == 'teacher' && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.scope == 'teacher');
    }

    // Audit data is append-only. Administrators may investigate events, but no audit
    // permission grants read access to reports or other teacher-private data.
    match /auditLogs/{entryId} {
      allow create: if activeAccount() && request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.type is string && request.resource.data.type.size() <= 100;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Administrative account controls. They contain no student content.
    match /adminRoles/{uid} {
      allow get: if activeAccount() && (uid == request.auth.uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /userDirectory/{uid} {
      allow get: if activeAccount() && (uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if activeAccount() && uid == request.auth.uid &&
        request.resource.data.uid == uid;
      allow delete: if isSuperAdmin();
    }

    match /blockedUsers/{uid} {
      allow get: if activeAccount() && (uid == request.auth.uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Default deny: new collections are inaccessible until explicitly reviewed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
