rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function activeAccount() {
      return signedIn() &&
        (!exists(accountPath(request.auth.uid)) ||
         get(accountPath(request.auth.uid)).data.status != 'blocked');
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'robiul20202090@gmail.com';
    }

    function isAdmin() {
      return activeAccount() &&
        (isSuperAdmin() || (exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid)) && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.isAdmin == true));
    }

    function ownsStudent(studentId) {
      return activeAccount() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.teacherUid == request.auth.uid;
    }

    function ownsBatch(batchId) {
      return activeAccount() &&
        exists(/databases/$(database)/documents/batches/$(batchId)) &&
        get(/databases/$(database)/documents/batches/$(batchId)).data.teacherUid == request.auth.uid;
    }

    function approvedGuardian(studentId) {
      return activeAccount() && exists(
        /databases/$(database)/documents/guardianApprovals/$(request.auth.uid)/students/$(studentId)
      );
    }

    function validOwnerWrite(teacherUid) {
      return activeAccount() && teacherUid == request.auth.uid;
    }

    // Signed-in accounts. An account owner maintains only their own profile;
    // administrators may change account status but cannot read student records.
    match /users/{uid} {
      allow create: if activeAccount()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'active';
      allow get: if activeAccount() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow update: if isSuperAdmin() || (
        activeAccount() && request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoURL', 'lastActiveAt'
        ])
      );
      // Profiles are never deleted: blocking is permanent until the super-admin reactivates the account.
      allow delete: if false;
    }

    // Reusable child profiles. A guardian may get one approved child only;
    // teacher list queries remain limited by the teacherUid ownership filter.
    match /students/{studentId} {
      allow create: if validOwnerWrite(request.resource.data.teacherUid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow get: if activeAccount() &&
        (resource.data.teacherUid == request.auth.uid || approvedGuardian(studentId));
      allow list: if activeAccount() && resource.data.teacherUid == request.auth.uid;
      allow update, delete: if ownsStudent(studentId)
        && request.resource.data.teacherUid == resource.data.teacherUid;
    }

    // Detailed individual-plan information remains visible only to a child's
    // approved guardian or the owning teacher.
    match /studentPrivate/{studentId} {
      allow get: if ownsStudent(studentId) || approvedGuardian(studentId);
      allow list: if false;
      allow create, update, delete: if ownsStudent(studentId)
        && request.resource.data.teacherUid == request.auth.uid;
    }

    match /batches/{batchId} {
      allow create: if validOwnerWrite(request.resource.data.teacherUid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow get, list: if activeAccount() && resource.data.teacherUid == request.auth.uid;
      allow update, delete: if ownsBatch(batchId)
        && request.resource.data.teacherUid == resource.data.teacherUid;

      // The complete roster and raw sessions are never available to guardians.
      match /members/{studentId} {
        allow read, write: if ownsBatch(batchId);
      }
      match /sessions/{sessionId} {
        allow read, write: if ownsBatch(batchId);
        match /entries/{studentId} {
          allow read, write: if ownsBatch(batchId);
        }
      }
    }

    // Limited per-child projections written by the teacher for guardian views.
    match /studentSummaries/{studentId}/records/{recordId} {
      allow get, list: if ownsStudent(studentId) || approvedGuardian(studentId);
      allow create, update, delete: if ownsStudent(studentId)
        && request.resource.data.teacherUid == request.auth.uid;
    }

    match /studentComparisons/{studentId}/batches/{batchId} {
      allow get, list: if ownsStudent(studentId) || approvedGuardian(studentId);
      allow create, update, delete: if ownsStudent(studentId)
        && request.resource.data.teacherUid == request.auth.uid;
    }

    // Exact-code lookup is allowed only after sign-in. Codes cannot be listed.
    // The code itself maps to identifiers only; it never exposes student data.
    match /roomCodes/{code} {
      allow get: if activeAccount();
      allow list: if false;
      allow create: if validOwnerWrite(request.resource.data.teacherUid)
        && ownsStudent(request.resource.data.studentId)
        && code.matches('[A-Z]{5}-[0-9]{2}-[A-Z]{5}');
      allow update: if false;
      allow delete: if activeAccount()
        && resource.data.teacherUid == request.auth.uid
        && ownsStudent(resource.data.studentId);
    }

    // Pending permission requests reveal a guardian identity only to the
    // teacher who owns the requested student.
    match /guardianRequests/{teacherUid}/requests/{requestId} {
      allow create: if activeAccount()
        && request.resource.data.guardianUid == request.auth.uid
        && request.resource.data.teacherUid == teacherUid
        && request.resource.data.status == 'pending'
        && request.resource.data.roomCode is string
        && exists(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode))
        && get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.studentId == request.resource.data.studentId
        && get(/databases/$(database)/documents/roomCodes/$(request.resource.data.roomCode)).data.teacherUid == teacherUid;
      allow get: if activeAccount() &&
        (teacherUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
      allow list: if activeAccount() && teacherUid == request.auth.uid;
      allow delete: if activeAccount() &&
        (teacherUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
      allow update: if false;
    }

    // An approval is the sole capability that lets a guardian read one child.
    match /guardianApprovals/{guardianUid}/students/{studentId} {
      allow get, list: if activeAccount() &&
        (guardianUid == request.auth.uid || ownsStudent(studentId));
      allow create: if ownsStudent(studentId)
        && request.resource.data.guardianUid == guardianUid
        && request.resource.data.studentId == studentId
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if false;
      // Approval and reverse-index documents are revoked together by the owning teacher.
      allow delete: if ownsStudent(studentId);
    }

    // A private reverse index lets the owning teacher revoke all approvals for one child.
    // It is not readable by guardians or administrators.
    match /studentGuardians/{studentId}/guardians/{guardianUid} {
      allow get, list: if ownsStudent(studentId);
      allow create: if ownsStudent(studentId)
        && request.resource.data.guardianUid == guardianUid
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if false;
      allow delete: if ownsStudent(studentId);
    }

    // Presence is deliberately short-lived and used only as an active count.
    match /presence/{studentId}/viewers/{guardianUid} {
      allow get, list: if ownsStudent(studentId);
      allow create, update: if approvedGuardian(studentId)
        && guardianUid == request.auth.uid
        && request.resource.data.guardianUid == request.auth.uid
        && request.resource.data.studentId == studentId
        && request.resource.data.lastSeen == request.time;
      allow delete: if activeAccount() &&
        (guardianUid == request.auth.uid || ownsStudent(studentId));
    }

    // Role assignments can be granted only by the configured super-admin.
    match /adminRoles/{uid} {
      allow get: if activeAccount() && (uid == request.auth.uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Audit entries are append-only. Client events are attributed to the
    // authenticated user; administrators are the only readers.
    match /auditLogs/{eventId} {
      allow create: if activeAccount()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.event is string
        && request.resource.data.event.size() <= 80;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    // Default-deny protection for any collection not explicitly defined above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
