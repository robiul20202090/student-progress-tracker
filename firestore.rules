rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function inviteOwner(inviteId) { return signedIn() && get(/databases/$(database)/documents/guardianInvites/$(inviteId)).data.ownerUid == request.auth.uid; }
    match /teachers/{teacherId}/snapshots/{snapshotId} { allow read, write: if isOwner(teacherId); }
    match /guardianInvites/{inviteId} { allow get: if true; allow list: if false; allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid; allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid; }
    match /guardianRequests/{inviteId}/items/{requestId} {
      allow create: if request.resource.data.state == 'pending' && request.resource.data.keys().hasOnly(['guardianName','relationship','state','requestedAt']) && request.resource.data.guardianName is string && request.resource.data.guardianName.size() > 0 && request.resource.data.guardianName.size() <= 80 && request.resource.data.relationship is string && request.resource.data.relationship.size() <= 40 && request.resource.data.requestedAt is timestamp;
      allow get: if true; allow list, update, delete: if inviteOwner(inviteId);
    }
    match /guardianAccess/{accessToken} {
      allow get: if true;
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /guardianViews/{accessToken}/items/{viewId} {
      allow create: if exists(/databases/$(database)/documents/guardianAccess/$(accessToken)) && request.resource.data.keys().hasOnly(['openedAt','updateId']) && request.resource.data.openedAt is timestamp && request.resource.data.updateId is string && request.resource.data.updateId.size() > 0 && request.resource.data.updateId.size() <= 220;
      allow get: if false; allow list: if signedIn() && get(/databases/$(database)/documents/guardianAccess/$(accessToken)).data.ownerUid == request.auth.uid; allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
