/* V4.8 isolated original-workflow experiment -------------------------------- */
.student-weekly-hero{background:linear-gradient(120deg,#eef8f3 0%,#fffdf7 58%,#f2f7ff 100%);border:1px solid #d8e8df;border-radius:14px;padding:18px 20px;box-shadow:0 8px 22px rgba(32,78,62,.08)}
.student-weekly-avatar{background:linear-gradient(145deg,#0f5c4f,#2f9c7d);box-shadow:0 8px 15px rgba(15,92,79,.2)}
.student-weekly-title h2{font-family:'Tiro Bangla',serif;font-weight:400;letter-spacing:.01em}
.student-weekly-intro{border:1px solid #e2d7bd;background:#fffaf0;border-radius:10px;box-shadow:0 3px 10px rgba(95,75,30,.05)}
.student-weekly-intro strong{color:#0f5c4f}
.student-workspace-tabs{border-bottom:2px solid #ddd4bf;gap:4px}
.student-workspace-tabs button{font-family:'Tiro Bangla','Hind Siliguri',sans-serif;color:#8a8373;padding:9px 14px}
.student-workspace-tabs button.active{color:#0f5c4f;border-bottom-color:#0f5c4f;background:#fffdf7}
.report-sheet{background:#fffdf7!important;border-color:#ddd4bf!important;border-radius:8px!important;box-shadow:0 3px 12px rgba(60,50,30,.08)!important;overflow:visible!important}
.report-top-nav{background:#f1f7f3;border-bottom:1px solid #dcebe2;padding:8px 16px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;color:#0f5c4f}
.report-top-nav span{font-family:'Tiro Bangla',serif;font-weight:600;margin-right:auto}
.report-top-nav button,.report-outline,.report-pill,.report-print{border-radius:6px!important;font-size:12px!important;padding:5px 9px!important}
.report-controls{background:#fbfaf6;border-bottom:1px solid #ddd4bf;padding:10px 16px!important}
.report-header{padding:16px 18px 10px!important;border-bottom:2px solid #1f2a24}
.report-header h2{font-family:'Tiro Bangla',serif;font-weight:400}
.report-meta{padding:12px 16px!important;background:#fffdf7!important}
.report-table-scroll,.wk-table-scroll{width:100%;max-width:100%;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;border-top:1px solid #dcebe2;border-bottom:1px solid #ddd4bf}
.report-table-scroll .report-table,.wk-table-scroll .wk-table,.report-table-scroll .weekly-entry-table{min-width:760px;width:100%}
.report-table-scroll input{min-width:72px}
.wk-scroll-hint{display:block!important;text-align:right;color:#8a8373;font-size:11px;padding:5px 16px 0}
.report-summary-cards{background:#fbfaf6;border-top:1px solid #ddd4bf}
.report-chart-section{border-top:1px solid #ddd4bf;background:#fffdf7}
@media(max-width:700px){
  .view-root{padding-left:12px;padding-right:12px;overflow-x:hidden}
  .student-weekly-hero{align-items:flex-start;padding:14px;gap:10px}
  .student-weekly-actions{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:7px}
  .student-weekly-actions .btn{min-height:38px;padding:0 9px;font-size:.78rem}
  .student-weekly-intro{display:grid;gap:3px;padding:10px 12px;font-size:.8rem}
  .report-sheet{margin-left:0;margin-right:0}
  .report-top-nav{padding:8px 10px}
  .report-top-nav span{width:100%}
  .report-controls{padding:8px 10px!important;gap:8px!important}
  .report-meta{grid-template-columns:repeat(2,minmax(130px,1fr))!important;padding:10px!important}
  .report-table-scroll,.wk-table-scroll{margin-left:0;margin-right:0;width:100%;}
  .report-table-scroll .report-table,.report-table-scroll .weekly-entry-table{min-width:760px}
  .report-summary-cards{grid-template-columns:repeat(3,minmax(150px,1fr));overflow-x:auto}
  .report-notes{grid-template-columns:repeat(2,minmax(190px,1fr));overflow-x:auto}
  .report-mini-grid{grid-template-columns:repeat(3,minmax(150px,1fr));overflow-x:auto}
}
@media(max-width:420px){
  .student-weekly-title h2{font-size:1.2rem}
  .student-weekly-actions{grid-template-columns:1fr}
  .report-meta{grid-template-columns:1fr!important}
  .report-top-nav button{font-size:11px!important;padding:4px 7px!important}
}
@media print{
  .sidebar,.topbar,.student-weekly-actions,.student-weekly-intro,.student-workspace-tabs,.report-top-nav,.report-controls,.wk-scroll-hint{display:none!important}
  .workspace{grid-column:1/-1}.view-root{padding:0}.report-sheet{box-shadow:none!important;border:0!important}
}
